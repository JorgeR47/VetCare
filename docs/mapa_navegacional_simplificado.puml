@startuml mapa_navegacional_simplificado
title Mapa navegacional y gestión de sesión · VetCare
left to right direction
hide empty description
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowFontSize 10
skinparam StateFontSize 10
skinparam nodesep 28
skinparam ranksep 42
skinparam ArrowThickness 1.4
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #3F3F3F
  ArrowColor #2E2E2E
  BackgroundColor<<recepcion>> #EAF6EF
  BackgroundColor<<veterinaria>> #F1ECFA
  BackgroundColor<<administracion>> #FCEFE6
  BackgroundColor<<sesion>> #DCE8FA
  BackgroundColor<<menu>> #FFF1BF
}

legend right
  <b>Convenciones</b>
  <color:#1565C0>━━━</color> Selección de rol o navegación entre módulos.
  <color:#00796B>━━━</color> Operación de una pantalla.
  <color:#2E7D32>━━━</color> Guardar o confirmar.
  <color:#6B7280>┄┄┄</color> Cancelar o volver.
  <color:#ED8B00>┄┄┄</color> Error; permanece en la pantalla.
  <color:#7E57C2>━━━</color> Atajo.
  <color:#C62828>┄┄┄</color> Cierre o expiración de sesión.
  La región «Control del menú» se aplica durante la sesión autenticada.
endlegend

state "index.html\nInicio de sesión" as LOGIN
[*] --> LOGIN : Abrir sistema
LOGIN -[#ED8B00,dashed]-> LOGIN : Ingresar [credenciales inválidas]
LOGIN -[#2E7D32]-> AUTH : Ingresar [credenciales válidas]

state "Sesión autenticada" as AUTH <<sesion>> {
  state "Navegación por rol" as ROLES {
    state "Determinar rol" as ROLE <<choice>>

    state "Recepcionista" as RECEPTION <<recepcion>> {
      state "M2 · Propietarios · CU-02" as OWNERS {
        state "propietario_listado.html" as LP
        state "propietario_registrar.html" as NP
        state "propietario_detalle.html" as DP
        state "propietario_editar.html" as EP
        state "propietario_dar_baja.html" as XP
      }
      state "M3 · Mascotas · CU-03" as PETS {
        state "mascota-listado.html" as LM
        state "mascota-nuevo.html" as NM
        state "mascota-detalle.html" as DM
        state "mascota-editar.html" as EM
        state "mascota-eliminar.html" as XM
      }
      state "M4 · Citas · CU-04 / CU-05" as APPOINTMENTS {
        state "cita-listado.html" as LC
        state "cita-nuevo.html" as NC
        state "cita-detalle.html" as DC
        state "cita-editar.html" as EC
        state "cita-eliminar.html" as XC
      }
      state "servicios.html\nConsulta de servicios" as SRVS

      LP -[#1565C0]down-> SRVS : Enlace «Servicios»
      SRVS -[#1565C0]up-> LP : Enlace «Propietarios»
      SRVS -[#1565C0]up-> LM : Enlace «Mascotas»
      SRVS -[#1565C0]right-> LC : Enlace «Citas»
      LP -[#1565C0]down-> LM : Enlace «Mascotas»
      LP -[#1565C0]right-> LC : Enlace «Citas»
      LM -[#1565C0]up-> LP : Enlace «Propietarios»
      LM -[#1565C0]down-> SRVS : Enlace «Servicios»
      LM -[#1565C0]right-> LC : Enlace «Citas»
      LC -[#1565C0]left-> LP : Enlace «Propietarios»
      LC -[#1565C0]left-> LM : Enlace «Mascotas»
      LC -[#1565C0]left-> SRVS : Enlace «Servicios»

      LP -[#00796B]-> NP : Registrar
      LP -[#00796B]-> DP : Ver detalle
      LP -[#00796B]-> EP : Editar
      LP -[#00796B]-> XP : Eliminar
      LP -[#2E7D32]-> LP : Buscar [hay coincidencias] / mostrar resultados
      LP -[#ED8B00,dashed]-> LP : Buscar [sin coincidencias] / mostrar aviso
      LP -[#ED8B00,dashed]-> LP : Ver detalle [registro no disponible] / mostrar aviso
      NP -[#2E7D32]-> LP : Guardar [datos válidos]
      NP -[#ED8B00,dashed]-> NP : Guardar [campos inválidos] / señalar errores
      NP -[#ED8B00,dashed]-> NP : Guardar [cédula duplicada] / informar duplicado
      NP -[#6B7280,dashed]-> LP : Cancelar
      DP -[#6B7280,dashed]-> LP : Volver al listado
      DP -[#00796B]-> EP : Editar
      EP -[#2E7D32]-> LP : Guardar [datos válidos]
      EP -[#ED8B00,dashed]-> EP : Guardar [campos inválidos] / señalar errores
      EP -[#ED8B00,dashed]-> EP : Guardar [cédula en uso] / informar conflicto
      EP -[#6B7280,dashed]-> LP : Cancelar
      XP -[#2E7D32]-> LP : Confirmar [eliminación permitida]
      XP -[#ED8B00,dashed]-> XP : Confirmar [tiene mascotas o citas] / mostrar bloqueo
      XP -[#ED8B00,dashed]-> XP : Confirmar [motivo inválido] / señalar motivo
      XP -[#6B7280,dashed]-> LP : Cancelar

      LM -[#00796B]-> NM : Registrar
      LM -[#00796B]-> DM : Ver detalle
      LM -[#00796B]-> EM : Editar
      LM -[#00796B]-> XM : Eliminar
      NM -[#2E7D32]-> LM : Guardar [datos válidos]
      NM -[#6B7280,dashed]-> LM : Cancelar
      EM -[#2E7D32]-> LM : Guardar [datos válidos]
      EM -[#6B7280,dashed]-> LM : Cancelar
      XM -[#2E7D32]-> LM : Confirmar eliminación
      XM -[#6B7280,dashed]-> LM : Cancelar
      DM -[#6B7280,dashed]-> LM : Volver
      DM -[#7E57C2]-> NC : Atajo «Agendar cita»

      LC -[#00796B]-> NC : Agendar
      LC -[#00796B]-> DC : Ver detalle
      LC -[#00796B]-> EC : Reprogramar
      LC -[#6B7280,dashed]-> XC : Cancelar cita
      NC -[#2E7D32]-> LC : Guardar [datos válidos]
      NC -[#6B7280,dashed]-> LC : Cancelar
      EC -[#2E7D32]-> LC : Guardar [datos válidos]
      EC -[#6B7280,dashed]-> LC : Cancelar
      XC -[#2E7D32]-> LC : Confirmar cancelación [motivo ingresado]
      XC -[#6B7280,dashed]-> LC : Cancelar
      DC -[#6B7280,dashed]-> LC : Volver
    }

    state "Veterinario" as VETERINARY <<veterinaria>> {
      state "menu-veterinario.html" as VET_HOME
      state "Agenda del día" as LA
      state "Detalle de cita" as DA
      state "Registrar atención" as NA
      state "Atención registrada" as CA
      state "Buscar mascota" as BH
      state "Historial clínico" as DH
      VET_HOME -[#1565C0]-> LA : Enlace «Agenda del día»
      VET_HOME -[#1565C0]-> BH : Enlace «Historial clínico»
      LA -[#00796B]-> DA : Seleccionar cita
      DA -[#00796B]-> NA : Registrar atención
      NA -[#2E7D32]-> CA : Guardar [datos válidos]
      BH -[#00796B]-> DH : Seleccionar mascota
      DA -[#6B7280,dashed]-> LA : Volver
      NA -[#6B7280,dashed]-> DA : Cancelar
      CA -[#6B7280,dashed]-> LA : Volver a la agenda
      DH -[#1565C0]-> VET_HOME : Enlace «Inicio»
    }

    state "Administrador" as ADMINISTRATION <<administracion>> {
      state "home_administrador.html" as ADM_HOME
      state "M6 · Veterinarios · CU-09" as VETS {
        state "veterinario_listar.html" as LV
        state "veterinario_nuevo.html" as NV
        state "veterinario_detalle.html" as DV
        state "veterinario_editar.html" as EV
        state "veterinario_eliminar.html" as XV
      }
      state "M6 · Recepcionistas · CU-11" as RECEPTIONISTS {
        state "recepcionista_listar.html" as LR
        state "recepcionista_nuevo.html" as NR
        state "recepcionista_detalle.html" as DR
        state "recepcionista_editar.html" as ER
        state "recepcionista_eliminar.html" as XR
      }
      state "M7 · Catálogo de servicios · CU-10" as SERVICES {
        state "servicio_listar.html" as LS
        state "servicio_nuevo.html" as NS
        state "servicio_detalle.html" as DS
        state "servicio_editar.html" as ES
        state "servicio_eliminar.html" as XS
      }
      state "Bitácora de auditoría" as LAU
      state "Detalle de auditoría" as DAU
      ADM_HOME -[#1565C0]-> LV : Personal Veterinario
      ADM_HOME -[#1565C0]-> LR : Personal Recepcionista
      ADM_HOME -[#1565C0]-> LS : Catálogo de servicios
      ADM_HOME -[#1565C0]-> LAU : Bitácora

      LV -[#1565C0]-> LR : Enlace «Personal recepcionista»
      LV -[#1565C0]-> LS : Enlace «Catálogo servicios»
      LV -[#1565C0]-> LAU : Enlace «Bitácora y auditoría»
      LR -[#1565C0]-> LV : Enlace «Personal veterinario»
      LR -[#1565C0]-> LS : Enlace «Catálogo servicios»
      LR -[#1565C0]-> LAU : Enlace «Bitácora y auditoría»
      LS -[#1565C0]-> LV : Enlace «Personal veterinario»
      LS -[#1565C0]-> LR : Enlace «Personal recepcionista»
      LS -[#1565C0]-> LAU : Enlace «Bitácora y auditoría»
      LAU -[#1565C0]-> LV : Enlace «Personal veterinario»
      LAU -[#1565C0]-> LR : Enlace «Personal recepcionista»
      LAU -[#1565C0]-> LS : Enlace «Catálogo servicios»

      LV -[#00796B]-> NV : Registrar
      LV -[#00796B]-> DV : Ver detalle
      LV -[#00796B]-> EV : Editar
      LV -[#00796B]-> XV : Dar de baja
      LV -[#2E7D32]-> LV : Buscar [hay coincidencias] / mostrar resultados
      LV -[#ED8B00,dashed]-> LV : Buscar [sin coincidencias] / mostrar aviso
      LV -[#ED8B00,dashed]-> LV : Ver detalle [registro no disponible] / mostrar aviso
      NV -[#2E7D32]-> LV : Guardar [datos válidos]
      NV -[#ED8B00,dashed]-> NV : Guardar [campos inválidos] / señalar errores
      NV -[#ED8B00,dashed]-> NV : Guardar [cédula duplicada] / informar duplicado
      NV -[#6B7280,dashed]-> LV : Cancelar
      DV -[#6B7280,dashed]-> LV : Volver al listado
      DV -[#00796B]-> EV : Editar
      EV -[#2E7D32]-> LV : Guardar [datos válidos]
      EV -[#ED8B00,dashed]-> EV : Guardar [campos inválidos] / señalar errores
      EV -[#ED8B00,dashed]-> EV : Guardar [cédula en uso] / informar conflicto
      EV -[#6B7280,dashed]-> LV : Cancelar
      XV -[#2E7D32]-> LV : Confirmar baja [baja permitida]
      XV -[#ED8B00,dashed]-> XV : Confirmar baja [tiene citas o atenciones asignadas] / mostrar bloqueo
      XV -[#ED8B00,dashed]-> XV : Confirmar baja [motivo inválido] / señalar motivo
      XV -[#6B7280,dashed]-> LV : Cancelar


      LR -[#00796B]-> NR : Registrar
      LR -[#00796B]-> DR : Ver detalle
      LR -[#00796B]-> ER : Editar
      LR -[#00796B]-> XR : Dar de baja
      LR -[#2E7D32]-> LR : Buscar [hay coincidencias] / mostrar resultados
      LR -[#ED8B00,dashed]-> LR : Buscar [sin coincidencias] / mostrar aviso
      LR -[#ED8B00,dashed]-> LR : Ver detalle [registro no disponible] / mostrar aviso
      NR -[#2E7D32]-> LR : Guardar [datos válidos]
      NR -[#ED8B00,dashed]-> NR : Guardar [campos inválidos] / señalar errores
      NR -[#ED8B00,dashed]-> NR : Guardar [cédula duplicada] / informar duplicado
      NR -[#6B7280,dashed]-> LR : Cancelar
      DR -[#6B7280,dashed]-> LR : Volver al listado
      DR -[#00796B]-> ER : Editar
      ER -[#2E7D32]-> LR : Guardar [datos válidos]
      ER -[#ED8B00,dashed]-> ER : Guardar [campos inválidos] / señalar errores
      ER -[#ED8B00,dashed]-> ER : Guardar [cédula en uso] / informar conflicto
      ER -[#6B7280,dashed]-> LR : Cancelar
      XR -[#2E7D32]-> LR : Confirmar baja [baja permitida]
      XR -[#ED8B00,dashed]-> XR : Confirmar baja [único recepcionista activo] / mostrar bloqueo
      XR -[#ED8B00,dashed]-> XR : Confirmar baja [motivo inválido] / señalar motivo
      XR -[#6B7280,dashed]-> LR : Cancelar

      LS -[#00796B]-> NS : Registrar
      LS -[#00796B]-> DS : Ver detalle
      LS -[#00796B]-> ES : Editar
      LS -[#00796B]-> XS : Dar de baja
      LS -[#2E7D32]-> LS : Buscar [hay coincidencias] / mostrar resultados
      LS -[#ED8B00,dashed]-> LS : Buscar [sin coincidencias] / mostrar aviso
      LS -[#ED8B00,dashed]-> LS : Ver detalle [registro no disponible] / mostrar aviso
      NS -[#2E7D32]-> LS : Guardar [datos válidos]
      NS -[#ED8B00,dashed]-> NS : Guardar [campos inválidos] / señalar errores
      NS -[#ED8B00,dashed]-> NS : Guardar [nombre duplicado] / informar duplicado
      NS -[#6B7280,dashed]-> LS : Cancelar
      DS -[#6B7280,dashed]-> LS : Volver al listado
      DS -[#00796B]-> ES : Editar
      ES -[#2E7D32]-> LS : Guardar [datos válidos]
      ES -[#ED8B00,dashed]-> ES : Guardar [campos inválidos] / señalar errores
      ES -[#ED8B00,dashed]-> ES : Guardar [nombre en uso] / informar conflicto
      ES -[#6B7280,dashed]-> LS : Cancelar
      XS -[#2E7D32]-> LS : Confirmar baja [baja permitida]
      XS -[#ED8B00,dashed]-> XS : Confirmar baja [tiene citas agendadas] / mostrar bloqueo
      XS -[#ED8B00,dashed]-> XS : Confirmar baja [motivo inválido] / señalar motivo
      XS -[#6B7280,dashed]-> LS : Cancelar

      LAU -[#00796B]-> DAU : Ver detalle
    }

    ROLE -[#1565C0]-> RECEPTION : [rol = RECEPCIONISTA]
    ROLE -[#1565C0]-> VETERINARY : [rol = VETERINARIO]
    ROLE -[#1565C0]-> ADMINISTRATION : [rol = ADMINISTRADOR]
  }
}

AUTH -[#C62828,dashed]-> LOGIN : Cerrar sesión
AUTH -[#C62828,dashed]-> LOGIN : Sesión expirada
@enduml

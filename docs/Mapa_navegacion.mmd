    A_SL -.->|"Cerrar sesión"| LOGIN
    A_VL -.->|"Cerrar sesión"| LOGIN
    A_RL -.->|"Cerrar sesión"| LOGIN
    A_BL -.->|"Cerrar sesión"| LOGIN

    %% ── Catálogo de servicios ──
    A_SL -->|"Buscar"| A_SL
    A_SL -->|"+ Registrar"| A_SN
    A_SL -->|"Ver detalle"| A_SD
    A_SL -->|"Editar"| A_SE
    A_SL -->|"Dar de baja"| A_SX
    A_SN -->|"Guardar"| A_SL
    A_SN -.->|"Cancelar"| A_SL
    A_SD -->|"Editar"| A_SE
    A_SD -.->|"Volver"| A_SL
    A_SE -->|"Guardar cambios"| A_SL
    A_SE -.->|"Cancelar"| A_SL
    A_SX -->|"Confirmar"| A_SL
    A_SX -.->|"Cancelar"| A_SL

    %% ── Personal veterinario ──
    A_VL -->|"Buscar"| A_VL
    A_VL -->|"+ Registrar"| A_VN
    A_VL -->|"Ver detalle"| A_VD
    A_VL -->|"Editar"| A_VE
    A_VL -->|"Dar de baja"| A_VX
    A_VN -->|"Guardar"| A_VL

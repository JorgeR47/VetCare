---
title: Mapa de navegación · VetCare
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
  theme: base
  themeCSS: ".titleText, .nodeLabel, .nodeLabel *, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, .label, .label * { color: #000000 !important; fill: #000000 !important; }"
  themeVariables:
    fontFamily: "Segoe UI, Helvetica, Arial, sans-serif"
    fontSize: 14px
    primaryTextColor: "#000000"
    secondaryTextColor: "#000000"
    tertiaryTextColor: "#000000"
    textColor: "#000000"
    nodeTextColor: "#000000"
    labelTextColor: "#000000"
    lineColor: "#475569"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: "#F8FAFC"
    clusterBorder: "#CBD5E1"
    titleColor: "#000000"
  flowchart:
    curve: linear
    htmlLabels: true
    nodeSpacing: 70
    rankSpacing: 110
    padding: 24
    diagramPadding: 24
    wrappingWidth: 220
---
flowchart LR
    %% Mapa de navegación a nivel de negocio: solo pantallas y nombres de botones o enlaces.

    LOGIN["Inicio de sesión"]

    subgraph RECEPCION["Recepcionista"]
        direction LR

        subgraph PROPIETARIOS["Propietarios"]
            direction LR
            P_L["Listado de Propietarios"]
            P_N["Registrar Propietario"]
            P_D["Ficha del Propietario"]
            P_E["Editar Propietario"]
            P_X["Dar de baja propietario"]
        end

        subgraph MASCOTAS["Mascotas"]
            direction LR
            M_L["Mascotas"]
            M_N["Registrar mascota"]
            M_D["Detalle de la mascota"]
            M_E["Editar mascota"]
            M_X["Dar de baja a una mascota"]
        end

        subgraph CITAS["Citas"]
            direction LR
            C_L["Citas"]
            C_N["Agendar cita"]
            C_D["Detalle de la cita"]
            C_R["Reprogramar cita"]
            C_X["Cancelar cita"]
        end

        subgraph SERVICIOS_R["Servicios"]
            direction LR
            S_R["Catálogo de servicios"]
        end
    end

    subgraph VETERINARIO["Veterinario"]
        direction LR

        subgraph AGENDA["Agenda y atención"]
            direction LR
            V_AG["Agenda del día"]
            V_DC["Detalle de la cita"]
            V_RA["Registrar atención médica"]
            V_CA["Confirmar atención"]
        end

        subgraph HISTORIA["Historia clínica"]
            direction LR
            V_HC["Historia clínica"]
            V_HCD["Historia clínica de la mascota"]
            V_AD["Detalle de atención médica"]
        end
    end

    subgraph ADMINISTRADOR["Administrador"]
        direction LR

        subgraph SERVICIOS_A["Catálogo de servicios"]
            direction LR
            A_SL["Catálogo de Servicios"]
            A_SN["Registrar servicio"]
            A_SD["Detalle del servicio"]
            A_SE["Editar servicio"]
            A_SX["Dar de baja servicio"]
        end

        subgraph VETERINARIOS["Personal veterinario"]
            direction LR
            A_VL["Personal Veterinario"]
            A_VN["Registrar veterinario"]
            A_VD["Detalle del veterinario"]
            A_VE["Editar veterinario"]
            A_VX["Dar de baja veterinario"]
        end

        subgraph RECEPCIONISTAS["Personal recepcionista"]
            direction LR
            A_RL["Personal Recepcionista"]
            A_RN["Registrar recepcionista"]
            A_RD["Detalle de la recepcionista"]
            A_RE["Editar recepcionista"]
            A_RX["Dar de baja recepcionista"]
        end

        subgraph BITACORA["Bitácora y auditoría"]
            direction LR
            A_BL["Bitácora y Auditoría"]
            A_BD["Detalle del registro"]
        end
    end

    %% ── Inicio de sesión ──
    LOGIN -->|"Ingresar al sistema"| P_L
    LOGIN -->|"Ingresar al sistema"| V_AG
    LOGIN -->|"Ingresar al sistema"| A_SL

    %% ── Recepcionista: enlaces de la barra entre pantallas principales ──
    P_L -->|"Mascotas"| M_L
    P_L -->|"Citas"| C_L
    P_L -->|"Servicios"| S_R
    M_L -->|"Propietarios"| P_L
    M_L -->|"Citas"| C_L
    M_L -->|"Servicios"| S_R
    C_L -->|"Propietarios"| P_L
    C_L -->|"Mascotas"| M_L
    C_L -->|"Servicios"| S_R
    S_R -->|"Propietarios"| P_L
    S_R -->|"Mascotas"| M_L
    S_R -->|"Citas"| C_L
    P_L -.->|"Cerrar sesión"| LOGIN
    M_L -.->|"Cerrar sesión"| LOGIN
    C_L -.->|"Cerrar sesión"| LOGIN
    S_R -.->|"Cerrar sesión"| LOGIN

    %% ── Propietarios ──
    P_L -->|"Buscar"| P_L
    P_L -->|"+ Nuevo propietario"| P_N
    P_L -->|"Ver"| P_D
    P_L -->|"Editar"| P_E
    P_L -->|"Dar de baja"| P_X
    P_N -->|"Guardar propietario"| P_L
    P_N -.->|"Cancelar"| P_L
    P_D -->|"Editar Propietario"| P_E
    P_D -.->|"Volver al listado"| P_L
    P_E -->|"Guardar cambios"| P_L
    P_E -.->|"Cancelar"| P_L
    P_X -->|"Confirmar baja"| P_L
    P_X -.->|"Cancelar"| P_L

    %% ── Mascotas ──
    M_L -->|"Buscar"| M_L
    M_L -->|"Registrar mascota"| M_N
    M_L -->|"Ver"| M_D
    M_L -->|"Editar"| M_E
    M_L -->|"Dar de baja"| M_X
    M_N -->|"Guardar"| M_L
    M_N -.->|"Cancelar"| M_L
    M_D -->|"Editar"| M_E
    M_D -.->|"Volver"| M_L
    M_E -->|"Guardar cambios"| M_L
    M_E -.->|"Cancelar"| M_L
    M_X -->|"Confirmar baja"| M_L
    M_X -.->|"Cancelar"| M_L

    %% ── Citas ──
    C_L -->|"Buscar"| C_L
    C_L -->|"Consultar turnos libres"| C_L
    C_L -->|"Agendar cita"| C_N
    C_L -->|"Elegir horario libre"| C_N
    C_L -->|"Ver"| C_D
    C_L -->|"Reprogramar"| C_R
    C_L -->|"Cancelar"| C_X
    C_N -->|"Agendar cita"| C_L
    C_N -.->|"Volver"| C_L
    C_D -->|"Reprogramar"| C_R
    C_D -->|"Cancelar cita"| C_X
    C_D -.->|"Volver"| C_L
    C_R -->|"Guardar cambios"| C_L
    C_R -.->|"Volver"| C_L
    C_X -->|"Confirmar cancelación"| C_L
    C_X -.->|"Volver"| C_L

    %% ── Servicios (consulta) ──
    S_R -->|"Buscar"| S_R

    %% ── Veterinario: enlaces de la barra entre pantallas principales ──
    V_AG -->|"Historia clínica"| V_HC
    V_HC -->|"Agenda del día"| V_AG
    V_HCD -->|"Agenda del día"| V_AG
    V_AG -.->|"Cerrar sesión"| LOGIN
    V_HC -.->|"Cerrar sesión"| LOGIN
    V_HCD -.->|"Cerrar sesión"| LOGIN

    %% ── Agenda y atención ──
    V_AG -->|"Consultar agenda"| V_AG
    V_AG -->|"Ver detalle"| V_DC
    V_AG -->|"Registrar atención"| V_RA
    V_DC -.->|"Volver"| V_AG
    V_RA -->|"Guardar atención"| V_CA
    V_RA -.->|"Cancelar"| V_AG
    V_CA -->|"Confirmar atención"| V_AG
    V_CA -.->|"Continuar editando"| V_RA
    V_CA -.->|"Cancelar"| V_AG

    %% ── Historia clínica ──
    V_HC -->|"Buscar"| V_HC
    V_HC -->|"Ver historia clínica"| V_HCD
    V_HCD -->|"Ver detalle"| V_AD
    V_HCD -.->|"Volver a historias clínicas"| V_HC

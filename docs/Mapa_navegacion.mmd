    %% Pantallas: colores visibles con letra negra
    classDef login fill:#60A5FA,stroke:#1E3A8A,stroke-width:2px,color:#000000,font-weight:bold
    classDef rec fill:#4ADE80,stroke:#166534,stroke-width:1.5px,color:#000000
    classDef vet fill:#A78BFA,stroke:#4C1D95,stroke-width:1.5px,color:#000000
    classDef adm fill:#FB923C,stroke:#9A3412,stroke-width:1.5px,color:#000000
    class LOGIN login
    class P_L,P_N,P_D,P_E,P_X,M_L,M_N,M_D,M_E,M_X,C_L,C_N,C_D,C_R,C_X,S_R rec
    class V_AG,V_DC,V_RA,V_CA,V_HC,V_HCD,V_AD vet
    class A_SL,A_SN,A_SD,A_SE,A_SX,A_VL,A_VN,A_VD,A_VE,A_VX,A_RL,A_RN,A_RD,A_RE,A_RX,A_BL,A_BD adm

    %% Paquetes: tonos pastel
    style RECEPCION fill:#E6F6EC,stroke:#7FC49B,stroke-width:1.5px,color:#000000
    style PROPIETARIOS fill:#F3FBF6,stroke:#7FC49B,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style MASCOTAS fill:#F3FBF6,stroke:#7FC49B,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style CITAS fill:#F3FBF6,stroke:#7FC49B,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style SERVICIOS_R fill:#F3FBF6,stroke:#7FC49B,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style VETERINARIO fill:#F1EAFB,stroke:#B39DDB,stroke-width:1.5px,color:#000000
    style AGENDA fill:#F8F4FD,stroke:#B39DDB,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style HISTORIA fill:#F8F4FD,stroke:#B39DDB,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style ADMINISTRADOR fill:#FDEEE2,stroke:#F0B48A,stroke-width:1.5px,color:#000000
    style SERVICIOS_A fill:#FFF7F0,stroke:#F0B48A,stroke-width:1px,stroke-dasharray:4 3,color:#000000
    style VETERINARIOS fill:#FFF7F0,stroke:#F0B48A,stroke-width:1px,stroke-dasharray:4 3,color:#000000

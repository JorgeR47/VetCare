    %% ── Administrador: enlaces de la barra entre pantallas principales ──
    A_SL -->|"Personal veterinario"| A_VL
    A_SL -->|"Personal recepcionista"| A_RL
    A_SL -->|"Bitácora y auditoría"| A_BL
    A_VL -->|"Catálogo servicios"| A_SL
    A_VL -->|"Personal recepcionista"| A_RL
    A_VL -->|"Bitácora y auditoría"| A_BL
    A_RL -->|"Catálogo servicios"| A_SL

flowchart LR
    %% ==========================================
    %% ACTORES DEL SISTEMA
    %% ==========================================
    actor_usuario["Usuario del Sistema<br/><i>(Abstracto)</i>"]
    actor_rec["<b>Recepcionista</b><br/>(Actor Primario)"]
    actor_vet["<b>Veterinario</b><br/>(Actor Primario)"]
    actor_admin["<b>Administrador</b><br/>(Actor Primario)"]
    actor_sistema["<b>Sistema</b><br/><i>(Procesos Automáticos)</i>"]
    actor_prop["<b>Propietario</b><br/><i>(Interesado Externo)</i>"]

    %% Generalización de actores de acceso
    actor_rec -->|Hereda credenciales| actor_usuario
    actor_vet -->|Hereda credenciales| actor_usuario
    actor_admin -->|Hereda credenciales| actor_usuario

    %% ==========================================
    %% LÍMITE DEL SISTEMA: VETCARE
    %% ==========================================
    subgraph VETCARE["Sistema Web VetCare (Clínica Huellitas)"]
        
        subgraph MOD_ACCESO["M1 · Módulo de Acceso"]
            CU01(["<b>CU-01</b><br/>Iniciar sesión"])
        end

        subgraph MOD_PROPIETARIOS_MASCOTAS["M2 & M3 · Pacientes y Clientes"]
            CU02(["<b>CU-02</b><br/>Gestionar propietarios"])
            CU03(["<b>CU-03</b><br/>Gestionar mascotas"])
        end

        subgraph MOD_CITAS["M4 · Citas y Turnos"]
            CU04(["<b>CU-04</b><br/>Agendar cita"])
            CU05(["<b>CU-05</b><br/>Gestionar citas"])
            CU14(["<b>CU-14</b><br/>Consultar disponibilidad<br/>de turnos"])
        end

        subgraph MOD_ATENCION["M5 · Atención Clínica"]
            CU06(["<b>CU-06</b><br/>Consultar agenda del día"])
            CU07(["<b>CU-07</b><br/>Registrar atención médica"])
            CU08(["<b>CU-08</b><br/>Consultar historia clínica"])
        end

        subgraph MOD_ADMIN["M6 · Personal y Auditoría"]
            CU09(["<b>CU-09</b><br/>Gestionar veterinarios"])
            CU11(["<b>CU-11</b><br/>Gestionar recepcionistas"])
            CU12(["<b>CU-12</b><br/>Consultar bitácora de auditoría"])
        end

        subgraph MOD_SERVICIOS["M7 · Catálogo de Servicios"]
            CU10(["<b>CU-10</b><br/>Gestionar servicios (Admin)"])
            CU13(["<b>CU-13</b><br/>Consultar catálogo de servicios (Recepción)"])
        end
    end


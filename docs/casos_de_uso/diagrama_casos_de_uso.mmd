---
title: Diagrama de casos de uso VetCare
---
flowchart LR
    classDef actor fill:#FFFFFF,stroke:#5B3FA8,color:#2E1F5E,stroke-width:1.5px;
    classDef usecase fill:#FFFFFF,stroke:#5B3FA8,color:#2E1F5E,stroke-width:1.5px;
    classDef note fill:#F4F1FB,stroke:#8A75C2,color:#2E1F5E,stroke-width:1px;

    subgraph ACTORES["Actores"]
        direction TB
        EMPLEADO["Empleado<br/>(abstracto)"]:::actor
        RECEPCIONISTA["Recepcionista"]:::actor
        VETERINARIO["Veterinario"]:::actor
        ADMINISTRADOR["Administrador"]:::actor
        RECEPCIONISTA -. "especializa" .-> EMPLEADO
        VETERINARIO -. "especializa" .-> EMPLEADO
        ADMINISTRADOR -. "especializa" .-> EMPLEADO
    end

    subgraph VETCARE["Sistema de gestión veterinaria VetCare"]
        direction TB

        subgraph M1["Acceso"]
            CU01(["CU-01<br/>Iniciar sesión"]):::usecase
        end

        subgraph M2["Propietarios y mascotas"]
            CU02(["CU-02<br/>Gestionar propietarios"]):::usecase
            CU03(["CU-03<br/>Gestionar mascotas"]):::usecase
        end

        subgraph M4["Citas y turnos"]
            CU04(["CU-04<br/>Agendar cita"]):::usecase
            CU05(["CU-05<br/>Gestionar citas"]):::usecase
            CU14(["CU-14<br/>Consultar disponibilidad<br/>de turnos"]):::usecase
        end

        subgraph M5["Atención médica"]
            CU06(["CU-06<br/>Consultar agenda del día"]):::usecase
            CU07(["CU-07<br/>Registrar atención médica"]):::usecase
            CU08(["CU-08<br/>Consultar historia clínica"]):::usecase
        end

        subgraph M6["Administración"]
            CU09(["CU-09<br/>Gestionar veterinarios"]):::usecase
            CU10(["CU-10<br/>Gestionar servicios"]):::usecase
            CU11(["CU-11<br/>Gestionar recepcionistas"]):::usecase
            CU12(["CU-12<br/>Consultar bitácora de auditoría"]):::usecase
        end

        subgraph M7["Catálogo de servicios"]
            CU13(["CU-13<br/>Consultar catálogo de servicios"]):::usecase
        end

        NOTA_MASCOTA["Al registrar una mascota,<br/>el sistema crea su historia clínica."]:::note
        NOTA_AUTOMATICA["Al finalizar el día, las citas sin atención<br/>pasan a No asistió y el cambio queda en auditoría."]:::note

        CU04 -. "&lt;&lt;include&gt;&gt;" .-> CU14
        CU07 -. "&lt;&lt;extend&gt;&gt; · opción desde la agenda" .-> CU06
        CU03 -.-> NOTA_MASCOTA
        CU04 -.-> NOTA_AUTOMATICA
        CU12 -.-> NOTA_AUTOMATICA
    end

    EMPLEADO --- CU01

    RECEPCIONISTA --- CU02
    RECEPCIONISTA --- CU03
    RECEPCIONISTA --- CU04
    RECEPCIONISTA --- CU05
    RECEPCIONISTA --- CU13
    RECEPCIONISTA --- CU14

    VETERINARIO --- CU06
    VETERINARIO --- CU07
    VETERINARIO --- CU08

    ADMINISTRADOR --- CU09
    ADMINISTRADOR --- CU10
    ADMINISTRADOR --- CU11
    ADMINISTRADOR --- CU12

    style VETCARE fill:#FFFFFF,stroke:#2E1F5E,stroke-width:2px
    style ACTORES fill:#FFFFFF,stroke:#8A75C2,stroke-width:1px
    style M1 fill:#F4F1FB,stroke:#5B3FA8,color:#2E1F5E
    style M2 fill:#F4F1FB,stroke:#5B3FA8,color:#2E1F5E
    style M4 fill:#F4F1FB,stroke:#5B3FA8,color:#2E1F5E

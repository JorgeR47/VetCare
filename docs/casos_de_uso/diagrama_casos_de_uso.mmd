    actor_rec --- CU02
    actor_rec --- CU03
    actor_rec --- CU04
    actor_rec --- CU05
    actor_rec --- CU13
    actor_rec --- CU14

    %% Veterinario (3 Casos de uso)
    actor_vet --- CU06
    actor_vet --- CU07
    actor_vet --- CU08

    %% Administrador (5 Casos de uso)
    actor_admin --- CU09
    actor_admin --- CU10
    actor_admin --- CU11
    actor_admin --- CU12

    %% Tareas del Sistema (Cambio a 'No asistió' y registro de auditoría)
    actor_sistema --- CU05
    actor_sistema --- CU12

    %% Propietario (Beneficiario del servicio e información)
    actor_prop -.- CU04
    actor_prop -.- CU13


@startuml CU_CajaCobros
' ==========================================================
' VetCare · Diagrama de casos de uso (UML 2.5)
' Se abre en IntelliJ IDEA con el plugin "PlantUML Integration".
' "smetana" es el motor de diagramación incluido en PlantUML:
' no requiere instalar Graphviz. (Si tienen Graphviz, pueden borrar la línea.)
' ==========================================================
!pragma layout smetana
left to right direction
title Módulo 5: Caja y Cobros (CC)

skinparam actorStyle stickman
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI", "Helvetica", sans-serif
skinparam defaultFontSize 12
skinparam ArrowColor #1B4F72
skinparam ArrowThickness 1.2

skinparam actor {
    BackgroundColor #D4E6F1
    BorderColor #1B4F72
    FontColor #0B172A
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #154360
    FontSize 12
}

skinparam rectangle {
    BackgroundColor #F8FBFE
    BorderColor #5DADE2
    FontColor #1B4F72
    FontStyle bold
}

skinparam package {
    BorderColor #5DADE2
    FontColor #1B4F72
    FontStyle bold
}

' Casos de uso de OTRO módulo (solo referencia en diagramas por módulo)
skinparam usecase<<Externo>> {
    BackgroundColor #F4F6F7
    BorderColor #AAB7B8
    FontColor #5D6D7E
}
hide <<Externo>> stereotype

' ==========================================================
' ACTORES
' ==========================================================
actor "Recepcionista" as Recepcionista

' ==========================================================
' CASOS DE USO
' ==========================================================
rectangle "Módulo 5: Caja y Cobros (CC) - Integrante 4" {
  usecase "CU-13: Registrar cobro de atención\n(presencial, con comprobante)" as CU13
}

rectangle "Módulo 3: Citas y Agenda (CA)" {
  usecase "CU-15: Buscar propietario\n(por cédula o nombre)" as CU15 <<Externo>>
}

' Relación con otro módulo
CU13 ..> CU15 : <<include>>

' ==========================================================
' ASOCIACIONES
' ==========================================================
Recepcionista --> CU13

@enduml

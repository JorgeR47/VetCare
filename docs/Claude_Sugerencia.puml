' =====================================================================
' Propuesta de mapa navegacional VetCare por niveles.
' Representa la misma navegación que mapa_navegacional.puml, repartida
' en 3 diagramas (cada @startuml genera una imagen):
'   1. Claude_Sugerencia_1_general   -> roles, menús y módulos
'   2. Claude_Sugerencia_2_crud      -> patrón CRUD común (M2, M3, M6, M7)
'   3. Claude_Sugerencia_3_especiales -> módulos con flujo propio (M4, M5, auditoría)
' =====================================================================

@startuml Claude_Sugerencia_1_general
title Mapa navegacional VetCare · Nivel 1: vista general\n(cada caja con ⊕ es un módulo: su detalle está en el nivel 2 o 3)
left to right direction
hide empty description
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowFontSize 10
skinparam StateFontSize 11
skinparam nodesep 30
skinparam ranksep 60
skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #3F3F3F
    ArrowColor #2E2E2E
    BackgroundColor<<menu>> #DCE8FA
    BackgroundColor<<modulo>> #F7F7F7
    BorderColor<<modulo>> #6B6B6B
}

legend right
    <b>Convenciones</b>
    Estado azul = pantalla de menú (archivo .html).
    Estado gris ⊕ = módulo (submáquina): agrupa varias pantallas; su detalle está en otro nivel.
    Flecha que ENTRA a un módulo = abre la pantalla indicada entre paréntesis (por defecto, el listado).
    Flecha que SALE de un módulo = la acción está disponible desde TODAS sus pantallas,
    salvo que se indique la pantalla de origen entre paréntesis.
    ● = inicio del sistema    ◉ = sesión cerrada
endlegend

state "index.html\nInicio de sesión · M1" as LOGIN
[*] --> LOGIN : Abrir el sistema
LOGIN --> LOGIN : Ingresar\n[credenciales inválidas]

state "ROL · RECEPCIONISTA" as ROLR #EAF6EF {
    state "menu_recepcionista.html\nMenú de recepcionista · M1" as REC <<menu>>
    state "⊕ M2 · Propietarios · CU-02" as M2 <<modulo>>
    M2 : propietario-listado / -nuevo / -detalle
    M2 : -editar / -eliminar .html
    M2 : → Nivel 2 (patrón CRUD)
    state "⊕ M3 · Mascotas e historia clínica · CU-03" as M3 <<modulo>>
    M3 : mascota-listado / -nuevo / -detalle
    M3 : -editar / -eliminar .html
    M3 : → Nivel 2 (patrón CRUD)
    state "⊕ M4 · Citas · CU-04 / CU-05" as M4 <<modulo>>
    M4 : cita-listado / -nuevo / -detalle
    M4 : -editar / -eliminar .html
    M4 : → Nivel 3
}

state "ROL · VETERINARIO" as ROLV #F1ECFA {
    state "menu_veterinario.html\nMenú del veterinario · M1 / M5" as VET <<menu>>
    state "⊕ M5 · Atención clínica · CU-06 / CU-07 / CU-08" as M5 <<modulo>>
    M5 : agenda-listado / agenda-detalle
    M5 : atencion-nuevo / atencion-confirmacion
    M5 : historial-detalle .html
    M5 : → Nivel 3
}

state "ROL · ADMINISTRADOR" as ROLA #FCEFE6 {
    state "menu_administrador.html\nMenú del administrador · M1" as ADM <<menu>>
    state "⊕ M6 · Veterinarios · CU-09" as M6V <<modulo>>
    M6V : veterinario-listado / -nuevo / -detalle
    M6V : -editar / -eliminar .html
    M6V : → Nivel 2 (patrón CRUD)
    state "⊕ M6 · Recepcionistas · CU-11" as M6R <<modulo>>
    M6R : recepcionista-listado / -nuevo / -detalle
    M6R : -editar / -eliminar .html
    M6R : → Nivel 2 (patrón CRUD)
    state "⊕ M7 · Catálogo de servicios · CU-10" as M7 <<modulo>>
    M7 : servicio-listado / -nuevo / -detalle
    M7 : -editar / -eliminar .html
    M7 : → Nivel 2 (patrón CRUD)
    state "⊕ Bitácora y auditoría" as AUD <<modulo>>
    AUD : auditoria_listar / auditoria_detalle .html
    AUD : → Nivel 3
}

' ----- Ingreso -----
LOGIN --> REC : Ingresar\n[rol: recepcionista]
LOGIN --> VET : Ingresar\n[rol: veterinario]
LOGIN --> ADM : Ingresar\n[rol: administrador]

' ----- Recepcionista -----
REC --> M2 : Enlace «Propietarios»
REC --> M3 : Enlace «Mascotas»
REC --> M4 : Enlace «Citas»
REC --> M4 : Atajo «Agendar cita»\n(abre cita-nuevo)
M3 --> M4 : Atajo «Agendar cita»\n(desde mascota-detalle; abre cita-nuevo)
M2 --> REC : Volver al menú
M2 --> [*] : Cerrar sesión
REC --> [*] : Cerrar sesión

' ----- Veterinario -----
VET --> M5 : Enlace «Agenda del día»\n(abre agenda-listado)
VET --> M5 : Enlace «Historial clínico»\n(abre el botón de búsqueda)
M5 --> VET : Enlace «Inicio»\n(desde historial-detalle)
VET --> [*] : Cerrar sesión

' ----- Administrador -----
ADM --> M6V : Personal Veterinario
ADM --> M6R : Personal Recepcionista
ADM --> M7 : Catálogo Servicios
ADM --> AUD : Bitácora y Auditoria
M6V --> ADM : Volver al menú
M6R --> ADM : Volver al menú
M7 --> ADM : Volver al menú
M6V --> LOGIN : Cerrar sesión
M6R --> LOGIN : Cerrar sesión
M7 --> LOGIN : Cerrar sesión
ADM --> [*] : Cerrar sesión

' ----- Disposición (flechas ocultas, no son transiciones) -----
M2 -[hidden]down-> M3
M3 -[hidden]down-> M4
M6V -[hidden]down-> M6R
M6R -[hidden]down-> M7
M7 -[hidden]down-> AUD
@enduml


@startuml Claude_Sugerencia_2_crud
title Mapa navegacional VetCare · Nivel 2: patrón CRUD\n(se dibuja una vez y se aplica a cada módulo de la tabla)
left to right direction
hide empty description
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowFontSize 10
skinparam StateFontSize 11
skinparam nodesep 35
skinparam ranksep 70
skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #3F3F3F
    ArrowColor #2E2E2E
}

legend right
    <b>Dónde se aplica</b> (reemplazar «entidad» por el nombre del archivo)
    | Módulo | entidad | Detalle → Editar |
    | M2 · Propietarios | propietario | sí |
    | M3 · Mascotas | mascota | no |
    | M6 · Veterinarios | veterinario | sí |
    | M6 · Recepcionistas | recepcionista | sí |
    | M7 · Servicios | servicio | sí |

    <b>Convenciones</b>
    [datos válidos] = validación HTML5 superada; si no, se permanece en la misma pantalla.
    Dos flechas con el mismo origen y destino son acciones distintas (Guardar / Cancelar).
    (†) = solo en los módulos marcados «sí» en la tabla.
    Entradas y salidas del módulo (menú, atajos, cerrar sesión): ver Nivel 1.
endlegend

state "Módulo CRUD de «entidad»" as CRUD {
    state "entidad-listado.html" as L
    state "entidad-nuevo.html" as N
    state "entidad-detalle.html" as D
    state "entidad-editar.html" as E
    state "entidad-eliminar.html" as X
}

[*] --> L : Entrada al módulo\n(desde el menú)

L --> N : Registrar
L --> D : Ver detalle
L --> E : Editar
L --> X : Eliminar
N --> L : Guardar\n[datos válidos]
N --> L : Cancelar
E --> L : Guardar\n[datos válidos]
E --> L : Cancelar
X --> L : Confirmar eliminación
X --> L : Cancelar
D --> L : Volver
D --> E : Editar (†)
@enduml


@startuml Claude_Sugerencia_3_especiales
title Mapa navegacional VetCare · Nivel 3: módulos con flujo propio
left to right direction
hide empty description
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowFontSize 10
skinparam StateFontSize 11
skinparam nodesep 30
skinparam ranksep 60
skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #3F3F3F
    ArrowColor #2E2E2E
    BackgroundColor<<boton>> #FFF1BF
    BorderColor<<boton>> #B38600
    BackgroundColor<<externo>> #F7F7F7
    BorderColor<<externo>> #9A9A9A
}

legend right
    <b>Convenciones</b>
    Fondo amarillo = botón sin archivo propio.
    Fondo gris = pantalla de otro nivel (solo indica de dónde se entra o a dónde se sale).
    [datos válidos] = validación HTML5 superada; si no, se permanece en la misma pantalla.
    Dos flechas con el mismo origen y destino son acciones distintas.
endlegend

' ----- M4 · Citas -----
state "M4 · Citas · CU-04 / CU-05" as M4 {
    state "cita-listado.html" as LC
    state "cita-nuevo.html" as NC
    state "cita-detalle.html" as DC
    state "cita-editar.html" as EC
    state "cita-eliminar.html" as XC
}
state "menu_recepcionista.html\n(Nivel 1)" as REC4 <<externo>>
state "mascota-detalle.html\n(Nivel 2 · M3)" as DM4 <<externo>>

REC4 --> LC : Enlace «Citas»
REC4 --> NC : Atajo «Agendar cita»
DM4 --> NC : Atajo «Agendar cita»
LC --> NC : Agendar
LC --> DC : Ver detalle
LC --> EC : Reprogramar
LC --> XC : Cancelar cita
NC --> LC : Guardar\n[datos válidos]
NC --> LC : Cancelar
EC --> LC : Guardar\n[datos válidos]
EC --> LC : Cancelar
XC --> LC : Confirmar cancelación\n[motivo ingresado]
XC --> LC : Cancelar
DC --> LC : Volver

' ----- M5 · Atención clínica -----
state "M5 · Atención clínica · CU-06 / CU-07 / CU-08" as M5 {
    state "agenda-listado.html" as LA
    state "agenda-detalle.html" as DA
    state "atencion-nuevo.html" as NA
    state "atencion-confirmacion.html" as CA
    state "Botón «Historial clínico»\n(botón: buscar y seleccionar mascota)" as BH <<boton>>
    state "historial-detalle.html\nConsulta de solo lectura" as DH
}
state "menu_veterinario.html\n(Nivel 1)" as VET5 <<externo>>

VET5 --> LA : Enlace «Agenda del día»\n(selección de fecha)
VET5 --> BH : Enlace «Historial clínico»
LA --> DA : Seleccionar cita
DA --> NA : Registrar atención
NA --> CA : Guardar\n[datos válidos]
BH --> DH : Seleccionar mascota
DA --> LA : Volver
NA --> DA : Cancelar
CA --> LA : Volver a la agenda
DH --> VET5 : Enlace «Inicio»

' ----- Bitácora y auditoría -----
state "Bitácora y auditoría" as AUD {
    state "auditoria_listar.html" as LAU
    state "auditoria_detalle.html" as DAU
}
state "menu_administrador.html\n(Nivel 1)" as ADM3 <<externo>>

ADM3 --> LAU : Bitácora y Auditoria
LAU --> DAU : Ver detalle

' ----- Disposición (flechas ocultas, no son transiciones) -----
LC -[hidden]down-> LA
LA -[hidden]down-> LAU
@enduml

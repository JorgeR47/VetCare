        A_SERV_LIST -->|"#ventana-nuevo"| A_SERV_NEW
        A_SERV_LIST -->|"#ventana-detalle"| A_SERV_DET
        A_SERV_LIST -->|"#ventana-editar"| A_SERV_EDIT
        A_SERV_LIST -->|"#ventana-dar-baja"| A_SERV_DEL
        A_SERV_NEW -->|"Guardar / Cancelar"| A_SERV_LIST
        A_SERV_DET -->|"Guardar / Cancelar"| A_SERV_LIST

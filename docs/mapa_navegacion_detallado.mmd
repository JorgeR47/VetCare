    %% ==========================================
    START((Inicio)) --> LOGIN["index.html<br/><b>Inicio de sesión</b>"]

    LOGIN -.->|"Credenciales inválidas"| LOGIN
    LOGIN -->|"Formulario submit / Chip Recepcionista"| R_PROP_LIST
    LOGIN -->|"Chip Veterinario"| V_AGENDA
    LOGIN -->|"Chip Administrador"| A_SERV_LIST

    %% ==========================================
    %% ROL: RECEPCIONISTA
    %% ==========================================
    subgraph ROL_RECEPCIONISTA["Área de Recepción"]
        R_PROP_LIST["pages/recepcionista/propietario/propietario_listado.html<br/><b>Listado de Propietarios</b>"]
        R_SERV["pages/recepcionista/servicios/servicios.html<br/><b>Catálogo de Servicios</b>"]

        %% Modales / Iframes de Propietario
        subgraph MODALES_PROPIETARIO["Modales incrustados (target='_top')"]
            R_PROP_NEW["propietario_registrar.html<br/><b>+ Nuevo propietario</b>"]
            R_PROP_DET["propietario_detalle.html<br/><b>Ver detalle</b>"]
            R_PROP_EDIT["propietario_editar.html<br/><b>Editar propietario</b>"]
            R_PROP_DEL["propietario_dar_baja.html<br/><b>Dar de baja</b>"]
        end

        %% Enlaces barra de navegación recepción
        R_PROP_LIST -->|"Nav: 'Servicios'"| R_SERV
        R_SERV -->|"Nav: 'Propietarios'"| R_PROP_LIST
        R_PROP_LIST -->|"Buscador (q=...)"| R_PROP_LIST

        %% Acciones a Modales
        R_PROP_LIST -->|"#ventana-nuevo"| R_PROP_NEW
        R_PROP_LIST -->|"#ventana-detalle"| R_PROP_DET
        R_PROP_LIST -->|"#ventana-editar"| R_PROP_EDIT
        R_PROP_LIST -->|"#ventana-eliminar"| R_PROP_DEL


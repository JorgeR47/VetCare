@startuml mapa_navegacional
title Mapa navegacional VetCare\n(máquina de estados: cada estado es una pantalla; cada flecha, la acción que provoca la transición)
left to right direction
hide empty description
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowFontSize 10
skinparam StateFontSize 11
skinparam nodesep 30
skinparam ranksep 55
skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #3F3F3F
    ArrowColor #2E2E2E
    BackgroundColor<<menu>> #DCE8FA
    BackgroundColor<<boton>> #FFF1BF
    BorderColor<<boton>> #B38600
}

legend right
    <b>Convenciones</b>
    Estado = pantalla (archivo .html). Fondo amarillo = botón sin archivo propio.
    ● = inicio del sistema    ◉ = sesión cerrada
    [datos válidos] = validación HTML5 superada; si no, se permanece en la misma pantalla.
    Dos flechas con el mismo origen y destino son acciones distintas (Guardar / Cancelar).
    El enlace «Cerrar sesión» está en el encabezado de todas las pantallas; se dibuja solo desde el menú.
endlegend

' ===== Inicio de sesión =====
state "index.html\nInicio de sesión · M1" as LOGIN
[*] --> LOGIN : Abrir el sistema
LOGIN --> LOGIN : Ingresar\n[credenciales inválidas]

' ===== Rol: Recepcionista =====
state "ROL · RECEPCIONISTA" as ROLR #EAF6EF {
    state "menu_recepcionista.html\nMenú de recepcionista · M1" as REC <<menu>>
        state "M2 · Propietarios · CU-02" as M2 {
            state "propietario-listado.html" as LP
            state "propietario-nuevo.html" as NP
            state "propietario-detalle.html" as DP
            state "propietario-editar.html" as EP
            state "propietario-eliminar.html" as XP
        }
        state "M3 · Mascotas e historia clínica · CU-03" as M3 {
            state "mascota-listado.html" as LM
            state "mascota-nuevo.html" as NM
            state "mascota-detalle.html" as DM
            state "mascota-editar.html" as EM
            state "mascota-eliminar.html" as XM
        }
        state "M4 · Citas · CU-04 / CU-05" as M4 {
            state "cita-listado.html" as LC
            state "cita-nuevo.html" as NC
            state "cita-detalle.html" as DC
            state "cita-editar.html" as EC
            state "cita-eliminar.html" as XC
        }
}

' ===== Rol: Veterinario =====
state "ROL · VETERINARIO" as ROLV #F1ECFA {
    state "menu_veterinario.html\nMenú del veterinario · M1 / M5" as VET <<menu>>
    state "M5 · Atención clínica · CU-06 / CU-07 / CU-08" as M5 {
        state "agenda-listado.html" as LA
        state "agenda-detalle.html" as DA
        state "atencion-nuevo.html" as NA
        state "atencion-confirmacion.html" as CA
        state "Botón «Historial clínico»\n(botón: buscar y seleccionar mascota)" as BH <<boton>>
        state "historial-detalle.html\nConsulta de solo lectura" as DH
    }
}

' ===== Rol: Administrador =====
state "ROL · ADMINISTRADOR" as ROLA #FCEFE6 {
    state "menu_administrador.html\nMenú del administrador · M1" as ADM <<menu>>
        state "M6 · Veterinarios · CU-09" as M6V {
            state "veterinario-listado.html" as LV
            state "veterinario-nuevo.html" as NV
            state "veterinario-detalle.html" as DV
            state "veterinario-editar.html" as EV
            state "veterinario-eliminar.html" as XV
        }
        state "M6 · Recepcionistas · CU-11" as M6R {
            state "recepcionista-listado.html" as LR
            state "recepcionista-nuevo.html" as NR
            state "recepcionista-detalle.html" as DR
            state "recepcionista-editar.html" as ER
            state "recepcionista-eliminar.html" as XR
        }
        state "M7 · Catálogo de servicios · CU-10" as M7 {
            state "servicio-listado.html" as LS
            state "servicio-nuevo.html" as NS
            state "servicio-detalle.html" as DS
            state "servicio-editar.html" as ES
            state "servicio-eliminar.html" as XS
        }
        state "auditoria_listar.html" as LAU
        state "auditoria_detalle.html" as DAU
}

' ===== Transiciones desde el inicio de sesión =====
LOGIN --> REC : Ingresar\n[rol: recepcionista]
LOGIN --> VET : Ingresar\n[rol: veterinario]
LOGIN --> ADM : Ingresar\n[rol: administrador]

' ===== Recepcionista: enlaces del menú y atajos =====
REC --> LP : Enlace «Propietarios»
REC --> LM : Enlace «Mascotas»
REC --> LC : Enlace «Citas»
REC --> NC : Atajo «Agendar cita»
DM --> NC : Atajo «Agendar cita»

' --- M2 · Propietarios · CU-02
LP --> NP : Registrar
LP --> DP : Ver detalle
LP --> EP : Editar
LP --> XP : Eliminar
NP --> LP : Guardar\n[datos válidos]
NP --> LP : Cancelar
EP --> LP : Guardar\n[datos válidos]
EP --> LP : Cancelar
XP --> LP : Confirmar eliminación
XP --> LP : Cancelar
DP --> LP : Volver
DP --> EP : Editar
' --- Volver al menú desde todas las páginas de Propietarios
LP --> REC : Volver al menú
NP --> REC : Volver al menú
DP --> REC : Volver al menú
EP --> REC : Volver al menú
XP --> REC : Volver al menú

' --- Cerrar sesión desde todas las páginas de Propietarios
LP --> [*] : Cerrar sesión
NP --> [*] : Cerrar sesión
DP --> [*] : Cerrar sesión
EP --> [*] : Cerrar sesión
XP --> [*] : Cerrar sesión

' --- M3 · Mascotas e historia clínica · CU-03
LM --> NM : Registrar
LM --> DM : Ver detalle
LM --> EM : Editar
LM --> XM : Eliminar
NM --> LM : Guardar\n[datos válidos]
NM --> LM : Cancelar
EM --> LM : Guardar\n[datos válidos]
EM --> LM : Cancelar
XM --> LM : Confirmar eliminación
XM --> LM : Cancelar
DM --> LM : Volver
' --- M4 · Citas · CU-04 / CU-05
LC --> NC : Agendar
LC --> DC : Ver detalle
LC --> EC : Reprogramar
LC --> XC : Cancelar cita
NC --> LC : Guardar\n[datos válidos]
NC --> LC : Cancelar
EC --> LC : Guardar\n[datos válidos]
EC --> LC : Cancelar
XC --> LC : Confirmar cancelación\n[motivo ingresado]
XC --> LC : Cancelar
DC --> LC : Volver

' ===== Veterinario: atención clínica =====
VET --> LA : Enlace «Agenda del día»\n(selección de fecha)
VET --> BH : Enlace «Historial clínico»
LA --> DA : Seleccionar cita
DA --> NA : Registrar atención
NA --> CA : Guardar\n[datos válidos]
BH --> DH : Seleccionar mascota
DA --> LA : Volver
NA --> DA : Cancelar
CA --> LA : Volver a la agenda
DH --> VET : Enlace «Inicio»

' ===== Administrador =====
ADM --> LV : Personal Veterinario
ADM --> LR : Personal Recepcionista
ADM --> LS : Catálogo Servicios
ADM --> LAU : Bitácora y Auditoria
LAU --> DAU : Ver detalle

' --- M6 · Veterinarios · CU-09
LV --> NV : Registrar
LV --> DV : Ver detalle
LV --> EV : Editar
LV --> XV : Eliminar
NV --> LV : Guardar\n[datos válidos]
NV --> LV : Cancelar
EV --> LV : Guardar\n[datos válidos]
EV --> LV : Cancelar
XV --> LV : Confirmar eliminación
XV --> LV : Cancelar
DV --> LV : Volver
DV --> EV : Editar
' --- Volver al menú desde todas las páginas de Veterinarios
LV --> ADM : Volver al menú
NV --> ADM : Volver al menú
DV --> ADM : Volver al menú
EV --> ADM : Volver al menú
XV --> ADM : Volver al menú

' --- Cerrar sesión desde todas las páginas de Veterinarios
LV --> LOGIN : Cerrar sesión
NV --> LOGIN : Cerrar sesión
DV --> LOGIN : Cerrar sesión
EV --> LOGIN : Cerrar sesión
XV --> LOGIN : Cerrar sesión
' --- M6 · Recepcionistas · CU-11
LR --> NR : Registrar
LR --> DR : Ver detalle
LR --> ER : Editar
LR --> XR : Eliminar
NR --> LR : Guardar\n[datos válidos]
NR --> LR : Cancelar
ER --> LR : Guardar\n[datos válidos]
ER --> LR : Cancelar
XR --> LR : Confirmar eliminación
XR --> LR : Cancelar
DR --> LR : Volver
DR --> ER : Editar
' --- Volver al menú desde todas las páginas de Recepcionistas
LR --> ADM : Volver al menú
NR --> ADM : Volver al menú
DR --> ADM : Volver al menú
ER --> ADM : Volver al menú
XR --> ADM : Volver al menú

' --- Cerrar sesión desde todas las páginas de Recepcionistas
LR --> LOGIN : Cerrar sesión
NR --> LOGIN : Cerrar sesión
DR --> LOGIN : Cerrar sesión
ER --> LOGIN : Cerrar sesión
XR --> LOGIN : Cerrar sesión
' --- M7 · Catálogo de servicios · CU-10
LS --> NS : Registrar
LS --> DS : Ver detalle
LS --> ES : Editar
LS --> XS : Eliminar
NS --> LS : Guardar\n[datos válidos]
NS --> LS : Cancelar
ES --> LS : Guardar\n[datos válidos]
ES --> LS : Cancelar
XS --> LS : Confirmar eliminación
XS --> LS : Cancelar
DS --> LS : Volver
DS --> ES : Editar
' --- Volver al menú desde todas las páginas de Servicios
LS --> ADM : Volver al menú
NS --> ADM : Volver al menú
DS --> ADM : Volver al menú
ES --> ADM : Volver al menú
XS --> ADM : Volver al menú

' --- Cerrar sesión desde todas las páginas de Servicios
LS --> LOGIN : Cerrar sesión
NS --> LOGIN : Cerrar sesión
DS --> LOGIN : Cerrar sesión
ES --> LOGIN : Cerrar sesión
XS --> LOGIN : Cerrar sesión

' ===== Disposición: módulos de un mismo rol apilados (flechas ocultas, no son transiciones) =====
LP -[hidden]down-> LM
LM -[hidden]down-> LC
LV -[hidden]down-> LR
LR -[hidden]down-> LS

' ===== Cierre de sesión =====
REC --> [*] : Cerrar sesión
VET --> [*] : Cerrar sesión
ADM --> [*] : Cerrar sesión
@enduml

@startuml
top to bottom direction
skinparam packageStyle rectangle

rectangle "index.html\nInicio de sesión · M1" as LOGIN
rectangle "menu_recepcionista.html\nMenú de recepcionista · M1" as REC
rectangle "menu_veterinario.html\nMenú del veterinario · M1 / M5" as VET
rectangle "menu_administrador.html\nMenú del administrador · M1" as ADM

LOGIN --> REC : Rol: recepcionista
LOGIN --> VET : Rol: veterinario
LOGIN --> ADM : Rol: administrador

package "M2 · Propietarios · CU-02" as M2 {
    rectangle "propietario-listado.html" as LP
    rectangle "propietario-nuevo.html" as NP
    rectangle "propietario-detalle.html" as DP
    rectangle "propietario-editar.html" as EP
    rectangle "propietario-eliminar.html" as XP

    LP ..> NP : Registrar
    LP --> DP : Ver
    LP --> EP : Editar
    LP --> XP : Eliminar
    NP --> LP : Retorno al listado
    DP --> LP : Retorno al listado
    EP --> LP : Retorno al listado
    XP --> LP : Retorno al listado
}

package "M3 · Mascotas e historia clínica · CU-03" as M3 {
    rectangle "mascota-listado.html" as LM
    rectangle "mascota-nuevo.html" as NM
    rectangle "mascota-detalle.html" as DM
    rectangle "mascota-editar.html" as EM
    rectangle "mascota-eliminar.html" as XM

    LM ..> NM : Registrar
    LM ..> DM : Ver ficha
    LM ..> EM : Editar
    LM ..> XM : Eliminar
}

package "M4 · Citas · CU-04 / CU-05" as M4 {
    rectangle "cita-listado.html" as LC
    rectangle "cita-nuevo.html" as NC
    rectangle "cita-detalle.html" as DC
    rectangle "cita-editar.html" as EC
    rectangle "cita-eliminar.html" as XC

    LC ..> NC : Agendar
    LC ..> DC : Ver
    LC ..> EC : Reprogramar
    LC ..> XC : Cancelar
    NC --> LC : Confirmación al agendar
}

package "M5 · Atención clínica · CU-06 / CU-07 / CU-08" as M5 {
    rectangle "agenda-listado.html" as LA
    rectangle "agenda-detalle.html" as DA
    rectangle "atencion-nuevo.html" as NA
    rectangle "atencion-confirmacion.html" as CA
    rectangle "Botón «Historial clínico»\nBuscar y seleccionar mascota" as BH
    rectangle "historial-detalle.html\nConsulta de solo lectura" as DH

    LA ..> DA : Seleccionar cita
    DA --> NA : Registrar atención
    NA ..> CA : Registro realizado
    BH ..> DH : Seleccionar mascota
}

package "M6 · Personal: Veterinarios · CU-09" as M6V {
    rectangle "veterinario-listado.html" as LV
    rectangle "veterinario-nuevo.html" as NV
    rectangle "veterinario-detalle.html" as DV
    rectangle "veterinario-editar.html" as EV
    rectangle "veterinario-eliminar.html" as XV

    LV ..> NV : Registrar
    LV ..> DV : Ver ficha
    LV ..> EV : Editar
    LV ..> XV : Eliminar
}

package "M6 · Personal: Recepcionistas · CU-11" as M6R {
    rectangle "recepcionista-listado.html" as LR
    rectangle "recepcionista-nuevo.html" as NR
    rectangle "recepcionista-detalle.html" as DR
    rectangle "recepcionista-editar.html" as ER
    rectangle "recepcionista-eliminar.html" as XR

    LR ..> NR : Registrar
    LR ..> DR : Ver ficha
    LR ..> ER : Editar
    LR ..> XR : Eliminar
}

package "M7 · Catálogo de servicios · CU-10" as M7 {
    rectangle "servicio-listado.html" as LS
    rectangle "servicio-nuevo.html" as NS
    rectangle "servicio-detalle.html" as DS
    rectangle "servicio-editar.html" as ES
    rectangle "servicio-eliminar.html" as XS

    LS ..> NS : Registrar
    LS ..> DS : Ver ficha
    LS ..> ES : Editar
    LS ..> XS : Eliminar
}

REC --> LP : Propietarios
REC --> LM : Mascotas
REC --> LC : Citas
REC --> NC : Atajo: Agendar cita
DM --> NC : Atajo: Agendar cita

VET --> LA : Agenda del día / selección de fecha
VET --> BH : Historial clínico

ADM --> LV : Veterinarios
ADM --> LR : Recepcionistas
ADM --> LS : Servicios
@enduml